<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>OdinStorageFix</AssemblyName>
    <RootNamespace>OdinStorageFix</RootNamespace>
    <Product>OdinStorageFix</Product>
    <Authors>Ntxfloy</Authors>
    <Company>Ntxfloy</Company>
    <Description>Modern Valheim compatibility patch for OdinStorage by Koehlerworks. Fixes terminal interaction, restores hover prompts, and enables direct UI hotkey opening.</Description>
    <Version>1.0.3</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <ValheimManaged>D:/Steam/steamapps/common/Valheim/valheim_Data/Managed</ValheimManaged>
    <BepInExCore>C:/Users/Ekaterina/AppData/Roaming/r2modmanPlus-local/Valheim/profiles/Default/BepInEx/core</BepInExCore>
    <PluginsDir>C:/Users/Ekaterina/AppData/Roaming/r2modmanPlus-local/Valheim/profiles/Default/BepInEx/plugins</PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManaged)/assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManaged)/assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManaged)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManaged)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Jotunn">
      <HintPath>$(PluginsDir)/ValheimModding-Jotunn/Jotunn.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="OdinStorage">
      <HintPath>$(PluginsDir)/Koehlerworks-OdinStorage/OdinStorage.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

